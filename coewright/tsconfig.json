{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "strictNullChecks": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "declaration": true,
    "allowJs": true,
    "lib": ["DOM", "ES2022", "DOM.Iterable"],
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "typeRoots": ["node_modules/@types"],
    "outDir": "dist/esm"
  }
}
