# Browser Settings
BROWSER_NAME=CHROMIUM
HEADLESS_MODE=false
BASE_URL=http://localhost:8080/

#Time Outs 
BROWSER_LAUNCH_TIMEOUT=0
TEST_TIMEOUT=20
NAVIGATION_TIMEOUT=2
ACTION_TIMEOUT=1
VISIBLE_TIMEOUT=60

# Test Execution configurations
RETRIES=0
PARALLEL_THREAD=1
TRACE_FLAG=retain-on-failure

# Adhock configurations
TEST_ENV=local

# Accessibility
AXE_FLAG=true

# PROXY - only for GCP
PROXY_SERVER=http://ep.threatpulse.net:80

# Applitools Visual Regression
APPLITOOLS_RUN=false
APPLITOOLS_API_KEY=
APPLITOOLS_SERVER_URL=https://lbgeyes.applitools.com/
