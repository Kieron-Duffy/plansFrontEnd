{
  "extends": "@interstellar/typescript-config-react/dist/tsconfig.json",
  "ts-node": {
    "files": true
  },
  "compilerOptions": {
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "outDir": "./dist/",
    "jsx": "react",
    "resolveJsonModule": true,
    "types": ["jest", "node"],
    "typeRoots": [
      "./node_modules/@types",
      "../../../node_modules/@types",
      "./node_modules/@interstellar/react-app/@types",
      "./node_modules/@interstellar/react-app/node_modules/@types"
    ],
    "paths": {
      "src/*": ["./src/*"],
      "routes": ["./src/routes"],
      "routes/*": ["./src/routes/*"],
      "assets/*": ["./src/assets/*"],
      "utils/*": ["./src/__tests__/utils"],
      "components": ["./src/components"],
      "components/*": ["./src/components/*"],
      "content": ["./src/content"],
      "content/*": ["./src/content/*"],
      "dataModel": ["./src/examples/dataModel"],
      "dataModel/*": ["./src/examples/dataModel/*"]
    }
  },
  "include": ["src", "."],
  "exclude": ["node_modules", "dist", "tests/**/*.ts", "coewright"],
  "lib": ["dom", "es6"]
}
